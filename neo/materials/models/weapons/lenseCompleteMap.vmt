// MX / ZR68L optic lens, replacing NT's lit translucent lens so the ironsight optic can draw its live
// view on it (neo_ironsight_optic.cpp swaps $basetexture to the optic render and turns the $detail
// reticle on while on the sights). Opaque: the render target's alpha is not meaningful.
"UnlitGeneric"
{
	"$basetexture"			"models/weapons/lenseCompleteMap"
	"$model"				"1"
	"$surfaceprop"			"plastic"

	// Reticle layer: declared here so the shader compiles detail support; off until the optic is live.
	"$detail"				"vgui/hud/optics/mx_reticle"
	"$detailscale"			"1"
	"$detailblendmode"		"2"
	"$detailblendfactor"	"0"
}
